# Copy to .env and fill in. The app opens a READ-ONLY connection pool —
# every session is started with default_transaction_read_only=on.
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=yourdb
DB_USER=readonly_user
DB_PASSWORD=changeme
# require | prefer | disable
DB_SSLMODE=require

# Optional tuning
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=30000

# How many days back a shipment still counts toward "active window" KPIs
ACTIVE_WINDOW_DAYS=7
# Hours without a GPS ping before an in-transit shipment is flagged
GPS_STALE_HOURS=4
# Ghost-ping speed ceiling (km/h) above which a ping is always a ghost
GHOST_MAX_SPEED_KMH=1100
# km radius used for "device reached destination vicinity" when dist_threshold is blank
DEFAULT_GEOFENCE_KM=1.0
